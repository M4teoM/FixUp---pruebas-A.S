# Configuracion del despliegue distribuido (dos maquinas).
# Copiar a .env.distributed y ajustar. NO se versiona con credenciales reales.


# ---- Maquina A: nodo de datos ----
# IP de la maquina A en la red local (no "localhost", no 127.0.0.1).
DATA_HOST=192.168.1.10
# Usuario y host para el contexto remoto de Docker sobre SSH: usuario@ip
DATA_SSH=estudiante@192.168.1.10
# Interfaz en la que la base publica el puerto dentro de la maquina A.
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=fixup
POSTGRES_USER=fixup
POSTGRES_PASSWORD=change-me-distributed

# ---- Maquina B: nodo de aplicacion ----
# IP de la maquina B: es la que escribe el navegador y la que usa el frontend para llamar al API.
APP_HOST=192.168.1.20
APP_BIND=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=4200

BACKEND_CONTEXT=../fixup-backend
FRONTEND_CONTEXT=../fixup-frontend

SPRING_PROFILES_ACTIVE=dev
AUTH0_ISSUER_URI=https://dev-uzssz142azr2k5hv.us.auth0.com/
AUTH0_AUDIENCE=urn:fixup:api

# Se calcula solo en el script si se deja vacio: http://APP_HOST:FRONTEND_PORT
CORS_ALLOWED_ORIGINS=
