<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="FIX&amp;RENT — FR-UC-18, FR-UC-20 y FR-UC-21" enabled="true">
      <stringProp name="TestPlan.comments">Espeja los escenarios del arnes de k6 para que los dos resultados sean comparables. Los tokens se leen de CSV; no se firma criptografia dentro de JMeter.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables del plan" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Parámetros" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,127.0.0.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CSV_DIR" elementType="Argument">
            <stringProp name="Argument.name">CSV_DIR</stringProp>
            <stringProp name="Argument.value">${__P(csvDir,perf/.work/jmeter)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DURATION" elementType="Argument">
            <stringProp name="Argument.name">DURATION</stringProp>
            <stringProp name="Argument.value">${__P(duration,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="P95_LECTURA" elementType="Argument">
            <stringProp name="Argument.name">P95_LECTURA</stringProp>
            <stringProp name="Argument.value">${__P(p95Lectura,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="P95_CARRERA" elementType="Argument">
            <stringProp name="Argument.name">P95_CARRERA</stringProp>
            <stringProp name="Argument.value">${__P(p95Carrera,1000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RPM_AUTH" elementType="Argument">
            <stringProp name="Argument.name">RPM_AUTH</stringProp>
            <stringProp name="Argument.value">${__P(rpmAuth,3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RPM_FALSOS" elementType="Argument">
            <stringProp name="Argument.name">RPM_FALSOS</stringProp>
            <stringProp name="Argument.value">${__P(rpmFalsos,1200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RPM_TECNICO" elementType="Argument">
            <stringProp name="Argument.name">RPM_TECNICO</stringProp>
            <stringProp name="Argument.value">${__P(rpmTecnico,1800)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RPM_PROPIETARIO" elementType="Argument">
            <stringProp name="Argument.name">RPM_PROPIETARIO</stringProp>
            <stringProp name="Argument.value">${__P(rpmPropietario,1200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RPM_INGRESOS" elementType="Argument">
            <stringProp name="Argument.name">RPM_INGRESOS</stringProp>
            <stringProp name="Argument.value">${__P(rpmIngresos,1800)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Valores por defecto HTTP" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
