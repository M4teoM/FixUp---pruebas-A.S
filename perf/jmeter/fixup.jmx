      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="FR-UC-21 · /auth/me nominal" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
