COMPOSE_PROJECT_NAME=fixup-local

FRONTEND_CONTEXT=../fixup-frontend
BACKEND_CONTEXT=../fixup-backend

FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432

POSTGRES_DB=fixup
POSTGRES_USER=fixup
POSTGRES_PASSWORD=change-me-local

SPRING_PROFILES_ACTIVE=dev

AUTH0_ISSUER_URI=https://example.auth0.com/
AUTH0_AUDIENCE=https://api.example.com

CORS_ALLOWED_ORIGINS=http://localhost:4200
