# FixUp en dos máquinas: VM Ubuntu de la universidad (API + datos) y este Mac (PWA).
# Copiar a .env.vm y completar. NO se versiona con credenciales reales.
# La IP de la VM puede cambiar: ./scripts/start-vm.sh <IP> la sobreescribe.
VM_IP=10.0.0.10
VM_USER=estudiante
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432
# Base de la entrega completa. Se crea aparte de la base anterior para no mezclar migraciones.
POSTGRES_DB=fixup_entrega1
POSTGRES_USER=fixup
POSTGRES_PASSWORD=change-me
APP_BIND=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=4200
STORAGE_PORT=9000
BACKEND_CONTEXT=../fixup-backend
FRONTEND_CONTEXT=../fixup-frontend
SPRING_PROFILES_ACTIVE=dev
AUTH0_ISSUER_URI=https://dev-uzssz142azr2k5hv.us.auth0.com/
AUTH0_AUDIENCE=urn:fixup:api
AUTH0_JWK_SET_URI=https://dev-uzssz142azr2k5hv.us.auth0.com/.well-known/jwks.json

# Datos de demostración (se cargan una sola vez; si ya existen no se repiten).
# Cada subject es el "sub" de Auth0 de la cuenta que verá los datos de ese protagonista.
# Van entre comillas porque llevan "|". scripts/desplegar-entrega1-vm.sh los completa solo.
FIXUP_SEED_ENABLED=true
FIXUP_SEED_OWNER_SUBJECT='auth0|...'
FIXUP_SEED_TENANT_SUBJECT='auth0|...'
FIXUP_SEED_FIXER_SUBJECT='auth0|...'
FIXUP_SEED_MANAGER_SUBJECT='auth0|...'
FIXUP_SEED_ADMIN_SUBJECT='auth0|...'
